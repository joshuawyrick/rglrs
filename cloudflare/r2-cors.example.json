{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://YOUR-REPLIT-DEV-DOMAIN",
          "https://YOUR-PRODUCTION-DOMAIN"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "x-amz-meta-owner"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
