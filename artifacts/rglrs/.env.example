# Browser-safe Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key used after RLS authorization to resolve protected media metadata.
SUPABASE_SECRET_KEY=

# Development/CI validation only. Do not configure as a browser or production runtime value.
SUPABASE_ACCESS_TOKEN=

# Private Cloudflare R2 server credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Google Places autocomplete is server-only.
GOOGLE_PLACES_API_KEY=

# Browser key for the What's Crackin map only. This value is intentionally browser-visible.
# Restrict it in Google Cloud to Maps JavaScript API only and these exact referrers:
# https://59204ef6-03f6-42fe-8123-2c15b21d523d-00-1efpiyhwk7lgs-rbodksnm.picard.replit.dev/*
# https://therglrs.com/*
# The development referrer is workspace-specific and may need updating when the workspace origin rotates.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional browser origin used by the authenticated release smoke test. Local
# release checks serve the isolated release server under the approved development
# origin; published checks default to the SMOKE_BASE_URL origin.
RELEASE_SMOKE_REFERRER=

# Public origin used for links and redirects
# Use the exact published/custom origin in production.
NEXT_PUBLIC_APP_URL=

# Strong, random server-only bearer secret for the scheduled private-media cleanup route.
# Generate independently per environment, for example: openssl rand -base64 48
SESSION_SECRET=
